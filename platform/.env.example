# Deployment settings read by deploy.ps1 / teardown.ps1. No secrets here: they are generated
# by deploy.ps1 and stored only in the Key Vault of the resource group.

# azd environment (weather-agent/.azure/<name>) - one environment = one resource group.
AZD_ENVIRONMENT="weather-kc"
# Resource group (default: rg-<AZD_ENVIRONMENT>). If it already exists it is reused as is:
# its location is used and its tags are never modified.
AZURE_RESOURCE_GROUP=""
# Target subscription (default: current `az account`) and region (hosted agents + Container Apps).
AZURE_SUBSCRIPTION_ID=""
AZURE_LOCATION="francecentral"
# Foundry project name (default: ai-project-<AZD_ENVIRONMENT>).
AZURE_AI_PROJECT_NAME=""

# Keycloak ("myID") image version (quay.io/keycloak/keycloak).
KEYCLOAK_VERSION="26.7.4"
