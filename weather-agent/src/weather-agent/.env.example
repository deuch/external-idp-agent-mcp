# Local run of the hosted agent (python main.py / F5). Values come from the deployed platform:
#   cd weather-agent; azd env get-values -e <env>
FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.4-mini"
MCP_SERVER_URL="https://ca-mcp-weather.<aca-domain>/mcp"
MCP_TOKEN_HEADER="x-client-mcp-token"
# Keycloak (myID) realm
OIDC_ISSUER="https://ca-keycloak.<aca-domain>/realms/weather"
OIDC_JWKS_URI="https://ca-keycloak.<aca-domain>/realms/weather/protocol/openid-connect/certs"
MCP_AUDIENCE="weather-mcp"
